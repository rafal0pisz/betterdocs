{
  "name": "pokero-traffic-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright bot simulating user traffic (clicks + scrolling) on pokero.pl/pl for UI regression / synthetic testing",
  "type": "module",
  "scripts": {
    "install-browsers": "playwright install --with-deps chromium",
    "start": "tsx src/cli.ts",
    "dry-run": "tsx src/cli.ts --sessions=1 --iterations=1 --headless=false"
  },
  "dependencies": {
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
